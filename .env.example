# ---------------------------------------------------------------------------
# Nimbus Chat configuration. Copy this file to `.env` and fill in values.
# `.env` is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# Which provider the backend talks to: "nvidia" or "ollama".
# Leave empty to auto-detect: NVIDIA when NVIDIA_API_KEY is set, otherwise the
# local Ollama runtime. The browser never sees this value.
LLM_PROVIDER=ollama

# --- Provider: NVIDIA NIM / NVIDIA API Catalog (OpenAI-compatible) ---------
# Get a free key at https://build.nvidia.com  ->  "Get API Key".
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# Override only if NVIDIA changes the endpoint.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Provider: local Ollama (no key required, runs on your machine) --------
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2:latest

# --- Server ---------------------------------------------------------------
PORT=3001

# System instruction prepended to every conversation.
SYSTEM_PROMPT=You are a helpful general-purpose AI assistant. Answer clearly, accurately, and concisely. If you are uncertain, say so.

# Request guards (server-side).
MAX_MESSAGE_CHARS=8000
MAX_CONTEXT_CHARS=24000
MAX_MESSAGES=40
UPSTREAM_TIMEOUT_MS=120000
