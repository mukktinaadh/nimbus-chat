{
  "name": "nimbus-chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A minimal general-purpose AI chatbot: React + Vite frontend, Express API proxy, OpenAI-compatible LLM providers (NVIDIA NIM, local Ollama).",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test test/"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
